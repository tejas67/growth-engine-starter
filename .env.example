# npm run setup creates .env with unique local credentials. Do not copy credentials from another installation.
# Optional API keys can be entered in Settings instead. They are stored in .local/secrets.json.
# Advanced setup variables (passed to npm run setup, not normally edited here):
# GROWTH_SETUP_DB_PORT=5447
# GROWTH_SETUP_APP_PORT=3100
# GROWTH_SETUP_USER=owner
# Use a password manager to supply GROWTH_SETUP_PASSWORD for non-interactive setup.
